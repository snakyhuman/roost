{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(cpack:*)",
      "Bash(ninja:*)",
      "Bash(zig:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(clang:*)",
      "Bash(clang++:*)",
      "Bash(qmllint:*)",
      "Bash(qmlformat:*)",
      "Bash(qmltestrunner:*)",
      "Bash(macdeployqt:*)",
      "Bash(otool:*)",
      "Bash(nm:*)",
      "Bash(objdump:*)",
      "Bash(readelf:*)",
      "Bash(ldd:*)",
      "Bash(pkg-config:*)",
      "Bash(lsof:*)",
      "Bash(chmod:*)"
    ],
    "ask": [
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(claude:*)"
    ],
    "deny": [
      "Edit(./external/**)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)"
    ]
  }
}
